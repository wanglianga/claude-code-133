{
  "name": "scenic-shuttle",
  "version": "1.0.0",
  "private": true,
  "description": "景区观光车排队上车与站点调度平台（React + NestJS + MySQL）",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -n nest,vite -c blue,green \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "seed": "npm run seed -w server",
    "start:server": "npm run start -w server",
    "test:e2e": "npm run test:e2e -w server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
